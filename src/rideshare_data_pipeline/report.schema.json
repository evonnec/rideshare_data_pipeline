{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rideshare-qc/report.schema.json",
  "title": "rideshare-qc report.json",
  "description": "The machine-readable QC report written by `rideshare-qc run`. schema_version changes when a field is removed or changes meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "summary", "checks", "exit_code"],
  "properties": {
    "schema_version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version", "input_name", "input_sha256", "input_size_bytes", "bom",
        "line_ending", "rows", "panelists", "window", "started", "finished",
        "elapsed_seconds", "config"
      ],
      "properties": {
        "tool_version": { "type": "string" },
        "input_name": { "type": "string", "description": "Base name of the input; never a full path." },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the file that was passed: the CSV, or the archive." },
        "input_size_bytes": { "type": "integer", "minimum": 0, "description": "Size of the file that was passed." },
        "bom": { "type": "boolean", "description": "The CSV that was read (the archive's member, for an archive) starts with a UTF-8 byte order mark." },
        "member": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "sha256", "size_bytes", "has_bom", "line_ending"],
          "description": "The CSV extracted from an archive input; null for a CSV input.",
          "properties": {
            "name": { "type": "string", "description": "Base name of the member inside the archive." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 0 },
            "has_bom": { "type": "boolean" },
            "line_ending": { "enum": ["crlf", "lf", "mixed"] }
          }
        },
        "line_ending": { "enum": ["crlf", "lf", "mixed"] },
        "rows": { "type": "integer", "minimum": 0 },
        "panelists": { "type": "integer", "minimum": 0, "description": "Distinct user_id values." },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "description": "Earliest and latest email_time, ISO 8601; null for a file with no rows.",
          "properties": {
            "start": { "type": ["string", "null"] },
            "end": { "type": ["string", "null"] }
          }
        },
        "started": { "type": "string", "description": "UTC, ISO 8601." },
        "finished": { "type": "string", "description": "UTC, ISO 8601." },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "cache": { "enum": ["hit", "miss", "off"], "description": "Whether the typed frame came from the Parquet cache (hit), was read and then cached (miss), or no cache was configured (off)." },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fail_on", "sample_limit", "checks"],
          "description": "The effective configuration, after the TOML file and CLI flags.",
          "properties": {
            "fail_on": { "enum": ["error", "warn"] },
            "sample_limit": { "type": "integer", "minimum": 0 },
            "checks": {
              "type": "object",
              "description": "Effective threshold and severity of every check that ran.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["threshold", "severity"],
                "properties": {
                  "threshold": { "type": ["number", "null"] },
                  "severity": { "enum": ["error", "warn", "info"] }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors_failed", "warnings_failed", "info", "passed", "total"],
      "properties": {
        "errors_failed": { "type": "integer", "minimum": 0 },
        "warnings_failed": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0, "description": "Number of info-severity checks." },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "check_id", "category", "severity", "passed", "metric",
          "threshold", "n_failed", "n_evaluated", "predicate", "details", "sample_file"
        ],
        "properties": {
          "name": { "type": "string" },
          "check_id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "enum": ["error", "warn", "info"] },
          "passed": { "type": "boolean" },
          "metric": { "type": ["number", "null"], "description": "The measured value (the failure rate for a row rule); null when nothing was evaluated." },
          "threshold": { "type": ["number", "null"], "description": "The most the metric may be for the check to pass; null for checks without one." },
          "n_failed": { "type": "integer", "minimum": 0 },
          "n_evaluated": { "type": "integer", "minimum": 0 },
          "predicate": { "type": "string", "description": "The rule a good row or dataset satisfies, in words." },
          "details": { "type": "object", "description": "Check-specific facts, e.g. the column names an info check found." },
          "sample_file": { "type": ["string", "null"], "description": "Path of the failing-row sample, relative to the report directory; null when none was written." }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "merchants", "kinds"],
      "description": "Receipts by merchant and receipt kind; present when the receipt_kinds check ran.",
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "merchants": { "type": "array", "items": { "type": "string" }, "description": "Merchant names, sorted; the keys of every by_merchant." },
        "kinds": {
          "type": "array",
          "description": "Every receipt kind, in canonical order (zero counts included).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "rider_spend", "total", "by_merchant"],
            "properties": {
              "kind": { "enum": ["ride", "tip_update", "fare_correction", "cancel_noshow", "payment_failed", "driver_earnings", "pass_or_credit", "micromobility", "food_order", "freight", "rental"] },
              "rider_spend": { "type": "boolean", "description": "Counts toward rider spend (ride, tip_update, fare_correction, cancel_noshow)." },
              "total": { "type": "integer", "minimum": 0 },
              "by_merchant": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
            }
          }
        }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naive_total", "currency_suspect", "non_rider_spend", "superseded", "clean_usd_rider_spend", "suspect_rider_spend", "note"],
      "description": "The spend waterfall; present when the currency_suspect_rows check ran. Rows are counted and amounts summed over receipts with an order_total_amount. clean_usd_rider_spend = naive_total - currency_suspect - non_rider_spend - superseded; each row is in exactly one of the last four groups. No FX conversion is applied.",
      "properties": {
        "naive_total": { "$ref": "#/$defs/spend_cell" },
        "currency_suspect": { "$ref": "#/$defs/spend_cell" },
        "non_rider_spend": { "$ref": "#/$defs/spend_cell" },
        "superseded": { "$ref": "#/$defs/spend_cell" },
        "clean_usd_rider_spend": { "$ref": "#/$defs/spend_cell" },
        "suspect_rider_spend": { "$ref": "#/$defs/spend_cell" },
        "note": { "type": "string", "description": "The currency caveat on the suspect amounts." }
      }
    },
    "exit_code": { "enum": [0, 1], "description": "The exit status of the run (2 is never written: input errors produce no report)." }
  },
  "$defs": {
    "spend_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "amount"],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "amount": { "type": "number", "description": "Sum of order_total_amount, rounded to cents." }
      }
    }
  }
}
